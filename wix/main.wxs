<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='StrikeHub'
        UpgradeCode='$(var.UpgradeCode)'
        Manufacturer='Strike48'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='StrikeHub Desktop — Unified Strike48 Connector Hub'
            Manufacturer='Strike48'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            Platform='$(var.Platform)' />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            DowngradeErrorMessage='A newer version of StrikeHub is already installed.' />

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1' />
        <Property Id='DiskPrompt' Value='StrikeHub Installation' />

        <!-- ── Directory layout ─────────────────────────────── -->
        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder'>
                <Directory Id='INSTALLDIR' Name='StrikeHub'>
                    <Directory Id='ConnectorsDir' Name='connectors' />
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='StrikeHubMenuFolder' Name='StrikeHub' />
            </Directory>

            <Directory Id='DesktopFolder' />
        </Directory>

        <!-- ── Files ────────────────────────────────────────── -->

        <DirectoryRef Id='INSTALLDIR'>
            <!-- Main executable -->
            <Component Id='StrikeHubExe' Guid='B1A34567-89AB-CDEF-0123-456789ABC001' Win64='yes'>
                <File Id='strikehub.exe'
                    Name='strikehub.exe'
                    Source='dist\strikehub.exe'
                    KeyPath='yes' />
            </Component>
            <!-- VC++ 2015-2022 runtime, app-local deployment. strikehub.exe is
                 built with the default MSVC dynamic CRT and imports
                 VCRUNTIME140.dll + VCRUNTIME140_1.dll (verified with dumpbin
                 /dependents on the release binary); a clean Windows 10 machine
                 ships no VC++ redist, so the installer carries exactly those
                 DLLs next to the executable. build-msi.ps1 stages them from
                 the build host's MSVC toolset (see redist\ provenance there).
                 x64 leg only: the arm64 exes are static-CRT builds and the
                 MSI compiles without these components ($(var.IncludeCrt) is
                 set by build-msi.ps1 -dIncludeCrt=...; the WiX preprocessor
                 strips the blocks entirely when it is 'no'). -->
            <?if $(var.IncludeCrt) = 'yes' ?>
            <Component Id='VcRuntimeInstallDir' Guid='B1A34567-89AB-CDEF-0123-456789ABC040' Win64='yes'>
                <File Id='vcruntime140InstallDir'
                    Name='vcruntime140.dll'
                    Source='redist\vcruntime140.dll'
                    KeyPath='yes' />
            </Component>
            <Component Id='VcRuntime1401InstallDir' Guid='B1A34567-89AB-CDEF-0123-456789ABC041' Win64='yes'>
                <File Id='vcruntime1401InstallDir'
                    Name='vcruntime140_1.dll'
                    Source='redist\vcruntime140_1.dll'
                    KeyPath='yes' />
            </Component>
            <?endif ?>
        </DirectoryRef>

        <DirectoryRef Id='ConnectorsDir'>
            <Component Id='KsConnector' Guid='B1A34567-89AB-CDEF-0123-456789ABC002' Win64='yes'>
                <File Id='ks_connector.exe'
                    Name='ks-connector.exe'
                    Source='dist\ks-connector.exe'
                    KeyPath='yes' />
            </Component>
            <Component Id='PentestAgent' Guid='B1A34567-89AB-CDEF-0123-456789ABC003' Win64='yes'>
                <File Id='pentest_agent.exe'
                    Name='pentest-agent.exe'
                    Source='dist\pentest-agent.exe'
                    KeyPath='yes' />
            </Component>
            <!-- Same app-local CRT copies for the bundled connectors: the DLL
                 search for a process starts in ITS OWN directory, so the copies
                 next to strikehub.exe are invisible to executables running from
                 connectors\. (The runtime cache copy staged by seed_vc_runtime
                 in sh-core covers the per-user cache dir.) x64 leg only —
                 static-CRT arm64 builds compile without these (see the block
                 above). -->
            <?if $(var.IncludeCrt) = 'yes' ?>
            <Component Id='VcRuntimeConnectorsDir' Guid='B1A34567-89AB-CDEF-0123-456789ABC042' Win64='yes'>
                <File Id='vcruntime140ConnectorsDir'
                    Name='vcruntime140.dll'
                    Source='redist\vcruntime140.dll'
                    KeyPath='yes' />
            </Component>
            <Component Id='VcRuntime1401ConnectorsDir' Guid='B1A34567-89AB-CDEF-0123-456789ABC043' Win64='yes'>
                <File Id='vcruntime1401ConnectorsDir'
                    Name='vcruntime140_1.dll'
                    Source='redist\vcruntime140_1.dll'
                    KeyPath='yes' />
            </Component>
            <?endif ?>
        </DirectoryRef>

        <!-- ── Environment variables ────────────────────────── -->
        <DirectoryRef Id='INSTALLDIR'>
            <Component Id='EnvVars' Guid='B1A34567-89AB-CDEF-0123-456789ABC010' Win64='yes'>
                <Environment Id='STRIKE48_API_URL'
                    Name='STRIKE48_API_URL'
                    Value='https://studio.strike48.com'
                    Permanent='no'
                    Part='all'
                    Action='set'
                    System='yes' />
                <Environment Id='STRIKE48_URL'
                    Name='STRIKE48_URL'
                    Value='wss://studio.strike48.com'
                    Permanent='no'
                    Part='all'
                    Action='set'
                    System='yes' />
                <!-- Add connectors dir to system PATH -->
                <Environment Id='ConnectorsPath'
                    Name='PATH'
                    Value='[ConnectorsDir]'
                    Permanent='no'
                    Part='last'
                    Action='set'
                    System='yes' />
                <!-- Sentinel key so WiX has something to key on -->
                <RegistryValue Root='HKLM'
                    Key='Software\Strike48\StrikeHub'
                    Name='EnvVarsInstalled'
                    Type='integer'
                    Value='1'
                    KeyPath='yes' />
            </Component>
        </DirectoryRef>

        <!-- ── Start Menu shortcut ──────────────────────────── -->
        <DirectoryRef Id='StrikeHubMenuFolder'>
            <Component Id='StartMenuShortcut' Guid='B1A34567-89AB-CDEF-0123-456789ABC020' Win64='yes'>
                <Shortcut Id='StrikeHubStartMenu'
                    Name='StrikeHub'
                    Description='StrikeHub Desktop'
                    Target='[INSTALLDIR]strikehub.exe'
                    WorkingDirectory='INSTALLDIR' />
                <RemoveFolder Id='RemoveMenuFolder' On='uninstall' />
                <RegistryValue Root='HKCU'
                    Key='Software\Strike48\StrikeHub'
                    Name='StartMenuShortcut'
                    Type='integer'
                    Value='1'
                    KeyPath='yes' />
            </Component>
        </DirectoryRef>

        <!-- ── Desktop shortcut ─────────────────────────────── -->
        <DirectoryRef Id='DesktopFolder'>
            <Component Id='DesktopShortcut' Guid='B1A34567-89AB-CDEF-0123-456789ABC030' Win64='yes'>
                <Shortcut Id='StrikeHubDesktop'
                    Name='StrikeHub'
                    Description='StrikeHub Desktop'
                    Target='[INSTALLDIR]strikehub.exe'
                    WorkingDirectory='INSTALLDIR' />
                <RegistryValue Root='HKCU'
                    Key='Software\Strike48\StrikeHub'
                    Name='DesktopShortcut'
                    Type='integer'
                    Value='1'
                    KeyPath='yes' />
            </Component>
        </DirectoryRef>

        <!-- ── Features ─────────────────────────────────────── -->
        <Feature Id='MainProgram' Title='StrikeHub' Level='1'
            ConfigurableDirectory='INSTALLDIR'
            AllowAdvertise='no' Absent='disallow'>
            <ComponentRef Id='StrikeHubExe' />
            <?if $(var.IncludeCrt) = 'yes' ?>
            <ComponentRef Id='VcRuntimeInstallDir' />
            <ComponentRef Id='VcRuntime1401InstallDir' />
            <?endif ?>
            <ComponentRef Id='EnvVars' />
            <ComponentRef Id='StartMenuShortcut' />

            <Feature Id='Connectors' Title='Bundled Connectors' Level='1'>
                <ComponentRef Id='KsConnector' />
                <ComponentRef Id='PentestAgent' />
                <?if $(var.IncludeCrt) = 'yes' ?>
                <ComponentRef Id='VcRuntimeConnectorsDir' />
                <ComponentRef Id='VcRuntime1401ConnectorsDir' />
                <?endif ?>
            </Feature>

            <Feature Id='DesktopShortcutFeature' Title='Desktop Shortcut' Level='1'>
                <ComponentRef Id='DesktopShortcut' />
            </Feature>
        </Feature>

        <!-- ── Add/Remove Programs metadata ─────────────────── -->
        <SetProperty Id='ARPINSTALLLOCATION' Value='[INSTALLDIR]' After='CostFinalize' />
        <Property Id='ARPHELPLINK' Value='https://github.com/Strike48-public/strikehub' />
        <Property Id='ARPURLINFOABOUT' Value='https://www.strike48.com' />

        <!-- WixUI dialog set -->
        <UIRef Id='WixUI_FeatureTree' />
        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf' />

    </Product>
</Wix>
