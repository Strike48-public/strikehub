#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit checks..."

# 1. Gitleaks - check for secrets
if command -v gitleaks &> /dev/null; then
    echo "  Checking for secrets (gitleaks)..."
    gitleaks protect --staged --no-banner
else
    echo "  WARNING: gitleaks not installed, skipping secret scan. Install with: brew install gitleaks"
fi

# 2. PII scan - block customer/tenant names from landing in this public repo.
# Scan only the added lines in staged changes. `git diff --cached` shows what's
# about to be committed; grep '^+[^+]' filters to additions only (ignoring the
# '+++' file-header lines). The scanner itself and its workflow/hooks are
# excluded because they legitimately contain the banned names as definitions.
SCANNER="$(git rev-parse --show-toplevel)/scripts/check-pii.sh"
if [[ -x "$SCANNER" ]]; then
    echo "  Checking for customer names (PII)..."
    added_lines="$(
        git diff --cached -- . \
            ':!scripts/check-pii.sh' \
            ':!.github/workflows/pii-check.yml' \
            ':!.githooks/pre-commit' \
            ':!.githooks/commit-msg' \
        | grep -E '^\+[^+]' || true
    )"
    if [[ -n "$added_lines" ]]; then
        if ! printf '%s\n' "$added_lines" | "$SCANNER" >&2; then
            echo "" >&2
            echo "Commit blocked: customer names (PII) found in staged changes." >&2
            echo "Remove the customer names above and retry, or bypass with --no-verify (not recommended)." >&2
            exit 1
        fi
    fi
else
    echo "  WARNING: $SCANNER not found or not executable, skipping PII check"
fi

# 3. Cargo fmt - check formatting
echo "  Checking formatting (cargo fmt)..."
cargo fmt --all -- --check

# 4. Clippy - catch common mistakes
echo "  Checking clippy..."
cargo clippy --workspace --all-targets -- -D warnings 2>&1

# 5. Cargo check - ensure it compiles
echo "  Checking compilation (cargo check)..."
cargo check --workspace 2>&1

echo "All pre-commit checks passed!"
