#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit checks..."

# 1. Gitleaks - check for secrets
if command -v gitleaks &> /dev/null; then
    echo "  Checking for secrets (gitleaks)..."
    gitleaks protect --staged --no-banner
else
    echo "  WARNING: gitleaks not installed, skipping secret scan. Install with: brew install gitleaks"
fi

# 2. PII scan - block customer/tenant names from landing in this public repo.
# Scan the added lines and the added/renamed paths in staged changes, the same
# way pii-check.yml does. Added lines are marked '>' so one whose own text
# starts with '+' is not mistaken for the '+++ b/<path>' header and skipped. A
# file named after a customer leaks the name even when its content is clean.
# Paths print unquoted (core.quotePath=false) so non-ASCII names match, and
# each path is also scanned with '_' as a space and with camelCase split,
# because the scanner matches whole words (see pii-check.yml for why all three
# forms are kept). The scanner and its workflow are excluded (they name the
# excluded paths, not customer names); this exclude set matches pii-check.yml
# so the local and CI scans cover the same files.
SCANNER="$(git rev-parse --show-toplevel)/scripts/check-pii.sh"
if [[ -x "$SCANNER" ]]; then
    echo "  Checking for customer names (PII)..."
    scope=(-- . ':!scripts/check-pii.sh' ':!.github/workflows/pii-check.yml')
    added_lines="$(
        git diff --cached --output-indicator-new='>' "${scope[@]}" \
        | grep -E '^>' || true
    )"
    paths="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=AR "${scope[@]}")"
    if [[ -n "$added_lines" || -n "$paths" ]]; then
        spaced="$(printf '%s\n' "$paths" | tr '_' ' ')"
        split="$(printf '%s\n' "$spaced" | sed -E 's/([a-z])([A-Z])/\1 \2/g; s/([A-Z])([A-Z][a-z])/\1 \2/g')"
        pii_rc=0
        printf '%s\n' "$added_lines" "$paths" "$spaced" "$split" | "$SCANNER" >&2 || pii_rc=$?
        if [[ $pii_rc -eq 1 ]]; then
            echo "" >&2
            echo "Commit blocked: customer names (PII) found in staged changes." >&2
            echo "Remove the customer names above and retry, or bypass with --no-verify (not recommended)." >&2
            exit 1
        elif [[ $pii_rc -ge 2 ]]; then
            echo "" >&2
            echo "Commit blocked: PII scanner is not configured (no name list)." >&2
            echo "Run scripts/install-hooks.sh or create .pii-names.local. See scripts/check-pii.sh." >&2
            exit 1
        fi
    fi
else
    echo "  WARNING: $SCANNER not found or not executable, skipping PII check"
fi

# 3. Cargo fmt - check formatting
echo "  Checking formatting (cargo fmt)..."
cargo fmt --all -- --check

# 4. Clippy - catch common mistakes
echo "  Checking clippy..."
cargo clippy --workspace --all-targets -- -D warnings 2>&1

# 5. Cargo check - ensure it compiles
echo "  Checking compilation (cargo check)..."
cargo check --workspace 2>&1

echo "All pre-commit checks passed!"
